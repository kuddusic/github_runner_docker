# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines (not after a value).

# GitHub account (or organization) whose repositories get runners
GITHUB_OWNER=kuddusic

# Fine-grained personal access token (GitHub > Settings > Developer settings):
#   Repository access:       All repositories (so new repos are picked up automatically)
#   Repository permissions:  Administration = Read and write
# (A classic PAT with the "repo" scope also works.)
GITHUB_PAT=

# Host directory for job workspaces (mounted at the same path inside the container).
# On a Mac it must also be shared with Docker Desktop, see the README.
RUNNER_WORK_ROOT=/opt/github_runner_work

# Optional
# RUNNER_LABELS=homelab,docker
# Only these repositories (comma-separated), default is all private repositories you administer
# REPO_INCLUDE=repo-a,repo-b
# Skip these repositories
# REPO_EXCLUDE=scratch
# Keep INCLUDE_PUBLIC false unless you accept the risk
# INCLUDE_PUBLIC=false
# INCLUDE_FORKS=false
# REFRESH_INTERVAL=300
# One job per runner, then re-register (clean state)
# EPHEMERAL=true
# true = never self-update the runner
# DISABLE_UPDATE=false
